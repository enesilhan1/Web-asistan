{
  "manifest_version": 3,
  "name": "__MSG_eklentiAdi__",
  "description": "__MSG_eklentiAciklamasi__",
  "version": "0.1.0",
  "default_locale": "tr",
  "icons": {
    "16": "icons/ikon16.png",
    "32": "icons/ikon32.png",
    "48": "icons/ikon48.png",
    "128": "icons/ikon128.png"
  },
  "permissions": ["tabs", "history", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/arka_plan.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/ikon16.png",
      "32": "icons/ikon32.png"
    },
    "default_title": "__MSG_eklentiAdi__"
  },
  "minimum_chrome_version": "120"
}
